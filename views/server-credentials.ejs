<section class="page-header">
  <div>
    <h1>🔑 Taarifa za Kuingia Panel</h1>
    <p class="page-subtitle"><%= server.name %></p>
  </div>
  <div class="header-actions">
    <a href="/dashboard/servers/<%= server._id %>" class="btn btn-outline">← Rudi</a>
  </div>
</section>

<section class="content-card">
  <div class="alert alert-info">
    <strong>ℹ️ Muhimu:</strong> Hifadhi taarifa hizi mahali salama. Password inaonekana mara moja tu.
  </div>

  <div class="credentials-box">
    <div class="cred-row">
      <label>Panel URL:</label>
      <div class="cred-value">
        <code><%= panelUrl %></code>
        <button class="btn-copy" onclick="copyText('<%= panelUrl %>')">📋</button>
      </div>
    </div>
    <div class="cred-row">
      <label>Username:</label>
      <div class="cred-value">
        <code><%= pteroUsername %></code>
        <button class="btn-copy" onclick="copyText('<%= pteroUsername %>')">📋</button>
      </div>
    </div>
    <div class="cred-row">
      <label>Password:</label>
      <div class="cred-value">
        <code id="pwd"><%= pteroPassword %></code>
        <button class="btn-copy" onclick="copyText('<%= pteroPassword %>')">📋</button>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <a href="<%= panelUrl %>" target="_blank" class="btn btn-primary btn-lg">
      🌐 Fungua Panel
    </a>
  </div>
</section>

<script>
  function copyText(text) {
    navigator.clipboard.writeText(text).then(() => {
      alert('✅ Imenakiliwa!');
    });
  }
</script>
