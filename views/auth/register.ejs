<section class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <div class="auth-icon">✨</div>
      <h1>Unda Akaunti Mpya</h1>
      <p>Pata coins za bure ukijiunga leo!</p>
    </div>

    <form action="/auth/register" method="POST" class="auth-form">
      <div class="form-group">
        <label for="username">Jina la Mtumiaji</label>
        <input
          type="text"
          id="username"
          name="username"
          placeholder="jina_lako"
          required
          minlength="3"
          maxlength="30"
          autocomplete="username"
        />
      </div>

      <div class="form-group">
        <label for="email">Barua Pepe</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="mfano@email.com"
          required
          autocomplete="email"
        />
      </div>

      <div class="form-group">
        <label for="password">Neno la Siri</label>
        <input
          type="password"
          id="password"
          name="password"
          placeholder="••••••••"
          required
          minlength="6"
          autocomplete="new-password"
        />
      </div>

      <div class="form-group">
        <label for="confirmPassword">Rudia Neno la Siri</label>
        <input
          type="password"
          id="confirmPassword"
          name="confirmPassword"
          placeholder="••••••••"
          required
          minlength="6"
          autocomplete="new-password"
        />
      </div>

      <button type="submit" class="btn btn-primary btn-block">
        Jisajili
      </button>
    </form>

    <div class="auth-footer">
      <p>Una akaunti tayari? <a href="/auth/login">Ingia hapa</a></p>
    </div>
  </div>
</section>
